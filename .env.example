# Fernet 密钥：可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
ENCRYPT_KEY=

# 在线模型 API Key（按启用的 provider 配置）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# LM Studio 本地一般可不校验；若需要可填占位
LMSTUDIO_API_KEY=lm-studio

# 可选：覆盖 config.yaml 中的数据库路径
# 本地开发：
# DATABASE_URL=sqlite:///./data/analyzer.db
# Docker（compose 已默认注入，一般无需再写）：
# DATABASE_URL=sqlite:////app/data/analyzer.db
